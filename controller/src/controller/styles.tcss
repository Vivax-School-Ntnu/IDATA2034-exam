#devices {
    padding: 0 5;
}

.device {
    background: $surface;
    margin: 1 0;
    padding: 1;
}

.device_name {
    width: 100%;
    text-align: center; 
    text-style: bold;
    color: $text-primary;
}

.sensor, .actuator {
    width: 100%;
}

.sensor_name, .actuator_name {
    color: $text-secondary;
}

.sensor_numeric_value {
    color: $text-accent;
    text-align: center;
    width: 5;
}

.actuator_numeric_value {
    text-align: center;
    color: $text-primary;

    border: solid $primary;
}

.sensor_binary_value {
    color: $text-secondary;
    border: none;
}

.actuator_binary_value {
    color: $text-primary;
    width: 100%;
    border: solid $primary;
}
